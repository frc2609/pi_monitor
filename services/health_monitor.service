[Unit]
Description=Vision coprocessor health monitor (power/throttle watchdog)
Documentation=file:///home/pi/vision/monitor/README.md

# No After= or Requires= photonvision, on purpose. This service has to outlive
# the thing it reports on - whatever kills PhotonVision must not take the
# witness with it.
#
# network.target, not network-online.target: the monitor must start even when
# the network doesn't. NetworkTables reconnects on its own.
After=network.target

# Never give up restarting. The default (5 restarts in 10s) would retire the
# watchdog during the exact brownout storm it exists for.
StartLimitIntervalSec=0

[Service]
# notify, not simple: the monitor pings systemd every loop. If it hangs - alive
# but stuck - systemd kills and restarts it. Restart=always cannot do that,
# because a stuck process never exits.
Type=notify

# Must comfortably exceed one loop's worst case: interval_s plus four vcgencmd
# timeouts (3s each) plus a systemctl check (5s), so about 17s. 60s leaves room
# for a slow card during a flush.
WatchdogSec=60

# vcgencmd needs the video group, not root. Check with:
#     sudo -u pi vcgencmd get_throttled
User=pi
Group=pi
SupplementaryGroups=video

WorkingDirectory=/home/pi/vision/monitor
Environment=PYTHONUNBUFFERED=1
# systemd does not expose the unit name to the process, and we need it
# to ask how many times we have been restarted.
Environment=UNIT_NAME=health_monitor.service

# The venv interpreter, NOT /usr/bin/python3. systemd never activates a venv,
# so pointing at the system python here fails with ModuleNotFoundError even
# though running it by hand works. Remove the venv and change this back.
ExecStart=/home/pi/vision/monitor/.venv/bin/python \
    /home/pi/vision/monitor/src/health_monitor.py \
    --config /home/pi/vision/monitor/config/config.yaml

Restart=always
RestartSec=2

# systemd creates and chowns these, so the monitor never needs root.
# Must match state_dir and log_dir in config/config.yaml.
StateDirectory=health_monitor
StateDirectoryMode=0755
LogsDirectory=health_monitor
LogsDirectoryMode=0755

# Under load this is the process least worth killing - it's the one recording
# what went wrong.
Nice=-5
OOMScoreAdjust=-500

# SIGTERM is what writes the clean-shutdown marker. Without a clean stop the
# next boot is recorded as a power cut that never happened.
KillSignal=SIGTERM
TimeoutStopSec=15

NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=health_monitor

[Install]
WantedBy=multi-user.target
