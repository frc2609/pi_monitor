# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments.
# Created by scripts/install_service.sh with --system-site-packages so the
# apt-installed packages stay visible. Never commit one — it contains
# absolute paths and architecture-specific binaries.
venv/
.venv/
vision-env/

# Logs and local scratch
*.log
fetched_logs/          # pulled off the Pi by scripts/fetch_logs.sh
captures/
scratch/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# NOTE: config/config.yaml is deliberately NOT ignored. It holds no secrets —
# only the team number, topic names, and thresholds — and a fresh Pi should
# get working defaults straight from the clone.

# Untracked for now. DESIGN.md and RUNNING.md describe a setup that has not
# been walked through on a real Pi yet, so they are kept local until the steps
# are confirmed. Remove this and `git add docs/` once they are.
docs/
